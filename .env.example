BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
ADMIN_ID=123456789
PORT=5000

# App Secret вашего приложения в Meta for Developers (Settings -> Basic).
# Нужен для проверки подписи входящих Instagram-вебхуков (защита от подделки запросов)
# и для автопродления Instagram-токена. Необязателен, но настоятельно рекомендуется.
IG_APP_SECRET=

# App ID вашего приложения (там же, Settings -> Basic, видно сразу без "Показать").
# Нужен вместе с IG_APP_SECRET только для автоматического продления Instagram Access Token.
IG_APP_ID=
