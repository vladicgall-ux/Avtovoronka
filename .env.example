BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
ADMIN_ID=123456789
PORT=5000

# Настоятельно рекомендуется: адрес внешней Postgres-базы (например, бесплатной на
# Neon.tech или Supabase). Без него настройки хранятся в локальном SQLite-файле,
# который может слетать при каждом рестарте/редеплое на некоторых хостингах.
# Формат: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Путь к локальному SQLite-файлу — используется только если DATABASE_URL не задан.
# Меняйте только если хостинг даёт постоянный диск и вы хотите указать его сюда.
DB_PATH=bot_settings.db

# App Secret вашего приложения в Meta for Developers (Settings -> Basic).
# Нужен для проверки подписи входящих Instagram-вебхуков (защита от подделки запросов)
# и для автопродления Instagram-токена. Необязателен, но настоятельно рекомендуется.
IG_APP_SECRET=

# App ID вашего приложения (там же, Settings -> Basic, видно сразу без "Показать").
# Нужен вместе с IG_APP_SECRET только для автоматического продления Instagram Access Token.
IG_APP_ID=
